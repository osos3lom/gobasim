# Sawt Gateway — environment template.
# Copy to .env and fill in. Never commit .env (it is gitignored).
# Names are generated from config/config.go; values here are placeholders only.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
SESSION_SECRET=            # long random string; signs dashboard session cookies
ADMIN_USERNAME=admin
ADMIN_PASSWORD=            # bcrypt-seeded on first run

# At least one LLM key is required.
NIM_API_KEY=
OPENAI_API_KEY=

# ── ERP (mshalia) integration ───────────────────────────────────────────────
MSHALIA_API_URL=https://mshalia.vercel.app
AGENT_GATEWAY_SECRET=      # must match mshalia's value; signs HMAC requests
DEFAULT_ORG_ID=            # fallback org for privileged roles with no org

# ── Optional: server ────────────────────────────────────────────────────────
PORT=8080
SECURE_COOKIE=false        # true in production (HTTPS only)
MAX_INFLIGHT=              # concurrent message-processing cap
RETENTION_DAYS=90          # 0 disables transcript retention/redaction
ERROR_WEBHOOK_URL=

# ── Optional: speech providers ──────────────────────────────────────────────
STT_PROVIDER=
STT_MODEL=
TTS_PROVIDER=
TTS_MODEL=
GROQ_API_KEY=
HF_API_KEY=
GCP_API_KEY=
OPENAI_API_BASE=
NIM_BASE_URL=
NIM_MODEL=
LLM_FALLBACK_MODEL=

# ── Optional: voice-note archival ───────────────────────────────────────────
VOICE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Optional: WhatsApp pairing ──────────────────────────────────────────────
PAIR_PHONE_NUMBER=         # country code first, e.g. 9665XXXXXXXX

# ── Local dev escape hatches ────────────────────────────────────────────────
ALLOW_MISSING_FFMPEG=      # true to run text-only without ffmpeg installed
LOG_FORMAT=                # "json" for structured logs
